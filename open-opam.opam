# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Publish a GitHub release to the open-opam registry"
description:
  "The checks a release must pass to enter the open-opam registry, the same for an author on their machine and for the registry's CI."
maintainer: ["open-opam <dev@hyphatech.io>"]
authors: ["open-opam contributors"]
license: "MIT"
homepage: "https://github.com/open-opam/open-opam-cli"
bug-reports: "https://github.com/open-opam/open-opam-cli/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "cmdliner" {>= "2.1.1"}
  "digestif" {>= "1.3.1"}
  "dune-build-info" {>= "3.18"}
  "eio" {>= "1.6"}
  "eio_main" {>= "1.6"}
  "fmt" {>= "0.9.0"}
  "mtime" {>= "2.0.0"}
  "opam-file-format" {>= "2.1.6"}
  "ptime" {>= "1.2.0"}
  "wiretype" {>= "0.7.0" & < "0.8.0"}
  "ppx_wiretype" {>= "0.7.0" & < "0.8.0"}
  "progress" {>= "0.5.0"}
  "alcotest" {with-test & >= "1.9.1"}
  "qcheck-alcotest" {with-test & >= "0.91"}
  "qcheck-core" {with-test & >= "0.91"}
  "merlin" {with-dev-setup & >= "5.6-504"}
  "ocaml-lsp-server" {with-dev-setup & >= "1.25.0"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "odoc" {with-dev-setup & >= "3.2.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/open-opam/open-opam-cli.git"
x-maintenance-intent: ["(latest)"]
x-open-opam: true
